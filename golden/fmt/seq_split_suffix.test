let a = [
  42
  // This is a comment before the trailing comma, that is going to be moved after it.
  ,
];

let b = [
  42
  // This one will merge
  ,
  // With the one below it.
];

let c = [
  // Comments and blanks before the comma, move after it.
  42

  ,
];

let c = [
  // If there is a blank on both sides of the comma, they fuse.
  [
    42
    // Before

    ,

    // After
  ],
  [
    42
    // Before

    ,
    // After
  ],
  [
    42
    // Before
    ,

    // After
  ],
];

let d = [
  // Blanks before the closing bracket remain, even without comma.
  42

];

null

